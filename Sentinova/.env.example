# Local development
DATABASE_URL=postgresql+psycopg://threatlens:threatlens_dev_password@localhost:5432/threatlens
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

# Optional enrichment providers
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
ABUSEIPDB_API_KEY=
ABUSECH_API_KEY=

# Authentication
AUTH_REQUIRED=true
JWT_SECRET=replace-with-a-long-random-secret
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!2026

# Maintenance/feed processing
MAINTENANCE_ENABLED=true
MAINTENANCE_INTERVAL_MINUTES=30
FEED_SCHEDULER_ENABLED=false
FEED_SCHEDULER_INTERVAL_MINUTES=5

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_AUTH_REQUIRED=true
